# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 32 bytes as 64 hex characters (openssl rand -hex 32); encrypts Slack bot tokens at rest
ENCRYPTION_KEY=

# Slack app
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_SCOPES=

# AI agent: Claude through OpenRouter (Anthropic-compatible Messages API) and
# query embeddings. EMBEDDING_* must match the ingest worker's values.
OPENROUTER_API_KEY=
AGENT_MODEL=anthropic/claude-sonnet-5.5
EMBEDDING_MODEL=voyageai/voyage-4-large
EMBEDDING_DIMENSIONS=1024
