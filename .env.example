# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 32 bytes as 64 hex characters (openssl rand -hex 32); encrypts Slack bot tokens at rest
ENCRYPTION_KEY=

# Slack app
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Optional, dev only: public HTTPS URL (e.g. an ngrok tunnel) Slack redirects to after OAuth.
# Must match the Redirect URL in the Slack app config. Leave unset in production.
SLACK_OAUTH_BASE_URL=

# AI agent: Claude through OpenRouter (Anthropic-compatible Messages API) and
# query embeddings. EMBEDDING_* must match the ingest worker's values.
OPENROUTER_API_KEY=
AGENT_MODEL=anthropic/claude-sonnet-5.5
EMBEDDING_MODEL=voyageai/voyage-4-large
EMBEDDING_DIMENSIONS=1024

# Billing: Dodo Payments. Anything other than "live_mode" runs in test mode.
# Use test-mode keys and product IDs locally.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
# Signing secret of the webhook endpoint registered at <public-url>/api/webhooks/dodo
DODO_PAYMENTS_WEBHOOK_KEY=
# Subscription product IDs (pdt_...)
DODO_PRODUCT_ID_MONTHLY=
DODO_PRODUCT_ID_ANNUAL=
# Bearer secret Vercel sends to /api/cron/* (billing reconciliation). Any long random string.
CRON_SECRET=
