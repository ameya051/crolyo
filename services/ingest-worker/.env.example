# Supabase Postgres. Use the session pooler (port 5432) or a direct connection:
# the transaction pooler (6543) doesn't support LISTEN/NOTIFY.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Embeddings through OpenRouter. Must match the Next.js app's EMBEDDING_* values.
# Without a key, content is still indexed for full-text search.
OPENROUTER_API_KEY=
EMBEDDING_MODEL=voyageai/voyage-4-large
EMBEDDING_DIMENSIONS=1024

WORKER_CONCURRENCY=3
LOG_LEVEL=INFO
